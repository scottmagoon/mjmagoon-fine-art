---
interface Props { accessKey: string; }
const { accessKey } = Astro.props;
const configured = Boolean(accessKey.trim()) && accessKey !== "YOUR_ACCESS_KEY_HERE";
---
<section id="contact" aria-labelledby="contact-heading">
  <h2 id="contact-heading">Contact Mary Jane</h2>
  <p>Interested in a painting, or have a question? Send Mary Jane a message. For artwork inquiries, please include the painting’s title.</p>
  <form id="contact-form" data-configured={String(configured)}>
    <input type="hidden" name="access_key" value={accessKey} />
    <input type="hidden" name="subject" value="New inquiry from MJ Magoon Fine Art" />
    <input type="hidden" name="from_name" value="MJ Magoon Fine Art" />
    <input type="checkbox" name="botcheck" class="honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <label for="contact-name">Your name</label>
    <input id="contact-name" name="name" type="text" autocomplete="name" required maxlength="200" />
    <label for="contact-email">Your email</label>
    <input id="contact-email" name="email" type="email" autocomplete="email" required maxlength="254" />
    <label for="contact-message">Message</label>
    <textarea id="contact-message" name="message" rows="6" required maxlength="10000"></textarea>
    {!configured && <p class="setup-notice">The contact form is being set up. Sending is not available yet.</p>}
    <button type="submit" disabled>Send message</button>
    <noscript><p>Please enable JavaScript to send a message.</p></noscript>
    <p id="contact-status" role="status" aria-live="polite" aria-atomic="true"></p>
  </form>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>("#contact-form");
  if (form) {
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const status = document.querySelector<HTMLParagraphElement>("#contact-status")!;
    const configured = form.dataset.configured === "true";
    button.disabled = !configured;
    let sending = false;
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!configured || sending || !form.reportValidity()) return;
      sending = true;
      button.disabled = true;
      button.textContent = "Sending…";
      status.textContent = "Sending your message…";
      const controller = new AbortController();
      const timeout = window.setTimeout(() => controller.abort(), 20000);
      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST", body: new FormData(form), signal: controller.signal,
        });
        const result = await response.json();
        if (!response.ok || !result.success) throw new Error("Submission failed");
        form.reset();
        status.textContent = "Thank you! Your message has been sent to Mary Jane.";
      } catch {
        status.textContent = "We couldn’t confirm that your message was sent. Your text is still here; please try again in a moment.";
      } finally {
        window.clearTimeout(timeout);
        sending = false;
        button.disabled = false;
        button.textContent = "Send message";
      }
    });
  }
</script>

<style>
  section { scroll-margin-top: 30px; }
  form { padding: 24px; background: #f6eddf; border: 1px solid #85674e; border-radius: 3px; max-width: 620px; color: #211a15; }
  label { display: block; font: 600 15px Helvetica, Arial, sans-serif; margin-bottom: 8px; }
  input:not([type="hidden"]), textarea { box-sizing: border-box; width: 100%; padding: 12px; margin-bottom: 20px; border: 1px solid #806a58; border-radius: 2px; background: #fffcf7; color: #17120f; font: 16px/1.5 Helvetica, Arial, sans-serif; }
  textarea { resize: vertical; min-height: 140px; }
  input.honeypot { display: none; }
  button { background: #573321; color: #fffaf2; border: 1px solid #573321; border-radius: 2px; padding: 13px 22px; font: 600 16px Helvetica, Arial, sans-serif; cursor: pointer; }
  button:hover:not(:disabled) { background: #382015; }
  button:disabled { opacity: 0.65; cursor: not-allowed; }
  :is(input, textarea, button):focus-visible { outline: 3px solid #784621; outline-offset: 3px; }
  .setup-notice, #contact-status { font: 15px/1.6 Helvetica, Arial, sans-serif; }
  #contact-status { margin: 16px 0 0; }
  #contact-status:empty { margin: 0; }
  @media (max-width: 480px) { form { padding: 18px; } }
</style>
